# Flight Sim Overlay v2
# Copy this file to .env. Never commit the live .env file.

# Local web server. Use 0.0.0.0 only when another device on your trusted LAN
# needs to load the overlay; 127.0.0.1 is the safer default.
FSO_HOST=127.0.0.1
FSO_PORT=5000
FSO_CONFIG_PATH=config/settings.json

# SimBrief accepts either a numeric user ID or username. The settings UI can
# also store this value. An OS environment value takes effect when the UI field
# is blank.
SIMBRIEF_USER_ID=
# SIMBRIEF_USERNAME=
SIMBRIEF_API_URL=https://www.simbrief.com/api/xml.fetcher.php

# SayIntentions.AI exposes flightJSON locally while its Windows client runs.
# The app first uses the URL, then falls back to the local file. Its SAPI key is
# auto-discovered from flightJSON and is never returned to the browser.
SAYINTENTIONS_FLIGHT_URL=http://127.0.0.1:63287/flightJSON
# SAYINTENTIONS_FLIGHT_JSON=C:\Users\YourName\AppData\Local\SayIntentionsAI\flight.json
# SAYINTENTIONS_API_KEY=

# VATSIM's public live-data feed does not require a credential.
VATSIM_DATA_URL=https://data.vatsim.net/v3/vatsim-data.json
